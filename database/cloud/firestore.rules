rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 本人(Firebase Authでサインイン済みのuid)だけが自分のデータを読み書きできる。
    // device/firestore_client.py はfirebase-admin SDK(サービスアカウント)を使うため
    // このルールの対象外(常に全権限を持つ)。
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /places/{placeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /visits/{visitId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
