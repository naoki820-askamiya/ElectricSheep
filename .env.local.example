# このファイルを .env.local という名前でコピーして使ってください。
# .env.local は git に登録されません（各自の環境用）。
# 変更したら開発サーバーを再起動してください（環境変数は起動時に読まれます）。

# ------------------------------------------------------------------
# 接続先の切り替え
# ------------------------------------------------------------------
#   self    … このアプリ内の /api/chat が Gemini を呼ぶ（初期値）
#   backend … よしたかのサーバーに繋ぐ
NEXT_PUBLIC_API_MODE=self

# backend モードのときだけ使う接続先
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------
# Gemini（NEXT_PUBLIC_API_MODE=self のときだけ必要）
# ------------------------------------------------------------------
# キーの取得: https://aistudio.google.com/apikey
#
# ★重要★ 頭に NEXT_PUBLIC_ を付けないこと。
# NEXT_PUBLIC_ を付けた変数はブラウザのJSに埋め込まれ、誰でも見られてしまいます。
# 付けずに書けばサーバー側だけで読まれ、外部に漏れません。
# GEMINI_API_KEY=

# モデル名。未指定時は route.ts の既定モデルを使います。
# 「no longer available」と出たら新しいモデルに差し替えてください。
# 使えるモデルの一覧:
#   curl "https://generativelanguage.googleapis.com/v1beta/models" -H "x-goog-api-key: キー"
# GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------
# Gemini Live / Raspberry Pi WebSocket バックエンド
# ------------------------------------------------------------------
# npm run backend で起動する別プロセス用。GEMINI_API_KEY は上と共用します。
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
PASSEN_BACKEND_HOST=0.0.0.0
PASSEN_BACKEND_PORT=8080

# ユーザーの返答を待つ時間。ツール処理中・Gemini応答中・音声再生中は数えません。
PASSEN_CONVERSATION_IDLE_MS=180000

# PiへGPSを要求して待つ時間と、既存場所とみなす距離。
PASSEN_LOCATION_TIMEOUT_MS=15000
PASSEN_NEARBY_RADIUS_METERS=100

# 任意。同じ値をPiの接続URL ?token=... に付けると端末を簡易認証できます。
# PASSEN_DEVICE_TOKEN=

# Firestoreへ書くバックエンドではAPIキーではなくサービスアカウントを使います。
# デプロイ環境ではApplication Default Credentialsを設定してください。
FIREBASE_PROJECT_ID=hakkason-database

# Firebase Auth導入前はWebアプリと同じ default_user へ保存します。
# 未指定にするとPiのhello.userIdをそのまま使用します。
PASSEN_FIRESTORE_USER_ID=default_user

# Firebase資格情報なしで会話だけ試す場合は memory。保存内容は再起動で消えます。
# PASSEN_DB_MODE=memory

# ------------------------------------------------------------------
# Firebase / Firestore
# ------------------------------------------------------------------
# 未指定でも既存の hakkason-database プロジェクトへ接続します。
# 別のFirebaseプロジェクトを使う場合だけ、以下を設定してください。
# Firebase Web設定はブラウザで使う公開識別子なので NEXT_PUBLIC_ を付けます。
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# 位置情報
# ------------------------------------------------------------------
# 室内デモ用の擬似GPS。true にすると実際の位置情報を使わず、
# 名古屋周辺を自動で移動しているように見せます。
NEXT_PUBLIC_USE_MOCK_GPS=true

GEMINI_API_KEY=ここを実際のAPIキーに置き換える
