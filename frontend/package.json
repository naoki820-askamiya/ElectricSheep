{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "copy:maplibre": "node -e \"const f=require('fs');f.mkdirSync('public/maplibre',{recursive:true});for(const n of ['maplibre-gl-worker.mjs','maplibre-gl-shared.mjs'])f.copyFileSync('node_modules/maplibre-gl/dist/'+n,'public/maplibre/'+n)\"",
    "postinstall": "npm run copy:maplibre"
  },
  "dependencies": {
    "maplibre-gl": "^6.6.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}