# このファイルを .env.local という名前でコピーして使ってください。
# .env.local は git に登録されません（各自の環境用）。
# 変更したら開発サーバーを再起動してください（環境変数は起動時に読まれます）。

# ------------------------------------------------------------------
# 接続先の切り替え
# ------------------------------------------------------------------
#   mock    … 通信せず固定の返事を返す（初期値。誰の実装も待たずに動く）
#   self    … このアプリ内の /api/chat が Gemini を呼ぶ（本物のAIと喋れる）
#   backend … よしたかのサーバーに繋ぐ
NEXT_PUBLIC_API_MODE=mock

# backend モードのときだけ使う接続先
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------
# Gemini（Live音声会話、または NEXT_PUBLIC_API_MODE=self で必要）
# ------------------------------------------------------------------
# キーの取得: https://aistudio.google.com/apikey
#
# ★重要★ 頭に NEXT_PUBLIC_ を付けないこと。
# NEXT_PUBLIC_ を付けた変数はブラウザのJSに埋め込まれ、誰でも見られてしまいます。
# 付けずに書けばサーバー側だけで読まれ、外部に漏れません。
# GEMINI_API_KEY=

# テキスト会話用モデル名。既定は src/app/api/chat/route.ts を参照。
# 「no longer available」と出たら新しいモデルに差し替えてください。
# 使えるモデルの一覧:
#   curl "https://generativelanguage.googleapis.com/v1beta/models" -H "x-goog-api-key: キー"
# GEMINI_MODEL=gemini-3.7-flash

# Live音声会話用モデル。通常は既定値のままで構いません。
# ブラウザにはAPIキーではなく、/api/live-token が発行する短命トークンだけを渡します。
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# ------------------------------------------------------------------
# Firebase / Firestore（未指定なら hakkason-database の既定値を使用）
# ------------------------------------------------------------------
# Firebase Web設定値は秘密情報ではありません。別プロジェクトへ切り替える場合だけ設定します。
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# 位置情報
# ------------------------------------------------------------------
# 室内デモ用の擬似GPS。true にすると実際の位置情報を使わず、
# 名古屋周辺を自動で移動しているように見せます。
NEXT_PUBLIC_USE_MOCK_GPS=true
